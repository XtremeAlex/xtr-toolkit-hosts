<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXListView?>
<?import com.jfoenix.controls.JFXToggleButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<StackPane fx:id="rootPane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.xtremealex.toolkit.hosts.mvp.controllers.MainController">

    <fx:define>
        <Font fx:id="titleFont" name="Arial" size="48"/>
        <Font fx:id="authorFont" name="Arial" size="24"/>
    </fx:define>

    <!-- Splash Screen -->
    <Pane fx:id="splashScreen" prefHeight="860" prefWidth="640" styleClass="splash-screen">
        <children>
            <AnchorPane prefHeight="860" prefWidth="640">
                <VBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                      AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                    <Label font="${titleFont}" styleClass="title-label" text="XTR HOST"/>
                    <Label font="${authorFont}" styleClass="author-label" text="by XtremeAlex"/>
                </VBox>
            </AnchorPane>
        </children>
    </Pane>

    <!-- Contenuto Principale -->
    <AnchorPane fx:id="mainContent" visible="false">
        <children>
            <!-- Sezione Superiore -->
            <HBox alignment="CENTER_LEFT" spacing="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
                  AnchorPane.topAnchor="10">
                <VBox spacing="1">

                    <HBox spacing="1">
                        <Label text="XTR TOOLKIT HOST" style="-fx-font-size: 35px; -fx-text-fill: black;"/>
                    </HBox>
                    <Label text="by XtremeAlex" style="-fx-font-size: 15px; -fx-text-fill: #333333;"/>

                    <!-- HBox per i pulsanti di modifica -->
                    <HBox fx:id="editButtonsBox" alignment="CENTER_LEFT" spacing="10">
                        <!-- Gli HOST sono gestiti da JAVA -->
                    </HBox>
                </VBox>

                <!-- Spaziatore -->
                <Region HBox.hgrow="ALWAYS"/>


                <Label alignment="CENTER_LEFT" text="MUSICA" style="-fx-font-size: 16px; -fx-text-fill: black;"/>
                <JFXToggleButton fx:id="musicToggleButton" onAction="#handleMusicToggle" prefHeight="58.0"
                                 prefWidth="182.0" selected="true" styleClass="custom-jfx-toggle-button"/>


            </HBox>

            <!-- Sezione Centrale -->
            <VBox fx:id="mainLayout" spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10"
                  AnchorPane.rightAnchor="10" AnchorPane.topAnchor="100">
                <padding>
                    <Insets bottom="1" left="1" right="1" top="1"/>
                </padding>
                <ScrollPane fx:id="scrollPane" fitToWidth="true">
                    <content>
                        <VBox fx:id="appsContainer" spacing="5"/>
                    </content>
                </ScrollPane>
            </VBox>
        </children>
    </AnchorPane>

    <!-- Edit Pane (Finestra di Modifica) -->
    <Pane fx:id="editPane" styleClass="edit-pane" visible="false">
        <children>
            <AnchorPane>
                <VBox alignment="CENTER" prefHeight="860" prefWidth="640" spacing="20" AnchorPane.bottomAnchor="0"
                      AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20"/>
                    </padding>
                    <Label styleClass="edit-title" text="Modifica Host"/>
                    <JFXListView fx:id="editHostListView" prefHeight="600" prefWidth="600"/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <JFXButton onAction="#handleCancelEdit" styleClass="mfx-button" text="Annulla"/>
                        <JFXButton onAction="#handleSaveEdit" styleClass="mfx-button" text="Salva"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </children>
    </Pane>
</StackPane>